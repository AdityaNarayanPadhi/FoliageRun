{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/health",
      "destination": "/api/index.js"
    },
    {
      "source": "/live-foliage",
      "destination": "/public/live-foliage.html"
    },
    {
      "source": "/community",
      "destination": "/public/community.html"
    },
    {
      "source": "/about",
      "destination": "/public/about.html"
    },
    {
      "source": "/(.*)",
      "destination": "/public/$1"
    }
  ]
}
